# Copia este archivo a .env.local y completa los valores.
# Las dos primeras son públicas por diseño: la clave publicable la protegen las
# políticas a nivel de fila (RN-12).
#
# NUNCA agregues aquí la clave service_role (REGLAS §4). La API se niega a
# arrancar si la encuentra en su entorno.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRETA. Clave maestra de los montos cifrados (SPEC 05, REGLAS §4): 32 bytes
# en base64. Sin ella la API no arranca. La usan también las pruebas.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# RESPÁLDALA fuera del repositorio y fuera de Supabase: si se pierde, todos los
# montos guardados quedan ilegibles. Nunca lleva prefijo público.
CLAVE_MONTOS_V1=

# Opcionales.
# PUERTO=4000
# ORIGEN_WEB=http://localhost:3000

# SOLO PRUEBAS. Va en .env.test.local (no en .env.local).
# La usan únicamente las pruebas de punta a punta (test/*.e2e-spec.ts) para
# crear y borrar usuarios con la Admin API. Nunca la lee código de src/
# ni atiende peticiones (REGLAS §4). Apunta solo a Tino dev, nunca a datos
# reales. Sin ella esas pruebas se omiten.
# SUPABASE_SECRET_KEY=
